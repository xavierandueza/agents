# One t0 isolated stack. Copy to ~/isolated-t0/<name>/stack.env and give every value below one no other
# stack (and not the default dev stack) uses.
# Plain KEY=value lines only: both repos' Makefiles `include` this file and `slot` sources it with sh,
# so no quotes, no $VARIABLES and no ~. Paths are absolute.

# Supabase project id and Docker compose label; slot removes the containers carrying it.
ISOLATED_COMPOSE_PROJECT=t0-s1
# Logs, the backend's generated env (backend.env) and the frontend's logs. reset-isolated wipes its parts.
ISOLATED_DATA_DIR=/home/you/isolated-t0/s1/data

ISOLATED_SUPABASE_API_PORT=55321
ISOLATED_SUPABASE_DB_PORT=55322
ISOLATED_SUPABASE_SHADOW_PORT=55320
ISOLATED_SUPABASE_INBUCKET_PORT=55324
ISOLATED_API_PORT=8180
ISOLATED_ADMIN_PORT=3110
ISOLATED_QUEUE_PORT=8223
ISOLATED_QUEUE_OIDC_PORT=8224
ISOLATED_METRO_PORT=8181

# Even, 5556-5584. The emulator also listens on the next port (adb); slot counts both.
ISOLATED_EMULATOR_PORT=5570
# The stack's own virtual device, created on first start; reset-isolated deletes it. Never t0 (the developer's).
ISOLATED_AVD=t0-s1
