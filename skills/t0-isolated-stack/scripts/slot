#!/bin/sh
# Lock, inspect and clean up one isolated stack. `slot --help` explains the protocol.
set -u

lock_dir=${VALIDATION_LOCK_DIR:-$HOME/validation-lock}
while [ "$lock_dir" != / ] && [ "${lock_dir%/}" != "$lock_dir" ]; do
	lock_dir=${lock_dir%/}
done
lock_log=${VALIDATION_LOCK_LOG:-$HOME/validation-lock.log}
slot_env=${VALIDATION_SLOT_ENV:-$HOME/validation-slot/.env.isolated}
owner_file=$lock_dir/owner.md

nl='
'
default_ports='3000 3001 4000 9563 27017 6379 3999 9229 9230 9231'
interface_port_vars='ISOLATED_README_PORT ISOLATED_MDX_PORT ISOLATED_GITTO_PORT ISOLATED_AI_PORT ISOLATED_MONGO_PORT ISOLATED_REDIS_PORT ISOLATED_OIDC_PORT'

example_env='.env.isolated.example (in any gitto, ai or readme checkout)'

usage() {
	cat <<EOF
slot: lock and clean up an isolated stack

An isolated stack is a readme + gitto + ai stack on its own ports (from its
.env.isolated) and its own data. A machine can run several, each with its own
.env.isolated and lock dir; slot acts on the one the variables under Files name.
Only the lock holder may start, stop, reset or use a stack. Nobody touches the
default dev stack (ports $default_ports).

Usage:
  slot acquire --owner <name> --check "<how to tell if the owner is alive>"
               --ticket <id> --objective "<text>" --expected-end <time>
               [--repo <name>:<branch>:<sha>:<path>]...
  slot status
  slot extend <time>
  slot stop [--id <lock id>]
  slot release [--id <lock id> [--force]]
  slot break --reason "<text>" [--force] [--by <name>]
  slot --help

<time> is +<N>m (N minutes from now) or ISO-8601 with a zone, e.g.
2026-11-18T15:30:00Z or 2026-11-18T15:30+11:00. It must be in the future.

Commands:
  acquire   Take the lock with an atomic mkdir of the lock directory and write
            owner.md. .env.isolated, docker and the port tool (see below) must exist;
            they're checked before the lock is taken. If the stack is taken, print
            the holder and whether the lock is overdue, then exit 1. Use --owner
            human when a person holds it. Prints the lock id; pass it to stop and
            release. Warns if .env.isolated has no ISOLATED_AI_TOKEN or ISOLATED_README_TOKEN,
            without printing either value.
  status    Print the holder, time left or how overdue, and the check: line.
            The check is never run; run it yourself.
  extend    Move expected_end. Only the holder extends, before it passes.
  stop      Stop everything in the stack and nothing else:
            1. docker rm -f the containers labelled with compose project
               \$ISOLATED_COMPOSE_PROJECT (volumes kept). Refused if that project
               publishes any port that isn't a stack port.
            2. Kill the listeners on every ISOLATED_*_PORT in .env.isolated. Container
               runtime port forwarders, unidentified processes and processes
               you can't see (another user's) are never killed; they're
               reported and stop fails.
            Refuses default dev ports. Fails if docker is unavailable.
            Holds the lock while it runs (taking it if the stack is free), so the
            stack can't change hands mid-stop.
  release   Stop the stack using the .env.isolated recorded in owner.md, then remove
            the lock and log it. If stop fails, the lock is kept, unless the
            holder passes --force (which needs --id): then release lists what
            is still running in the stack, logs it as force-release, and frees
            the lock anyway.
  break     Release someone else's lock. Only allowed once it is past
            expected_end, never when expected_end is unreadable. Refuses
            owner: human unless --force. Logs who broke it (--by, default your
            user name) and why.

With --id, stop and release refuse unless the lock has that id, so a late or
repeated call can't stop or free the next holder's stack. Holders should always
pass it.

extend, stop, release and break first rename owner.md to
owner.md.<extending|stopping|releasing|breaking>.<pid>, so only one of them acts
on a lock at a time. extend, stop and a refused break rename it back. stop on a
free stack holds the lock dir with a stopping.<pid> file instead.

Stale-lock rule:
  If acquire fails, run the holder's check: (or ask them). While the lock is
  not overdue, wait or do other work; never break it. Once it is overdue and
  the holder is gone, break it with a reason. If owner is human, ask that person
  and only use --force with their agreement. A lock that slot can't read (no
  owner.md, or no valid expected_end) is for a human to inspect and remove.

Files (paths can be overridden with the variables shown):
  Lock dir  \${VALIDATION_LOCK_DIR:-\$HOME/validation-lock}      now: $lock_dir
  Log       \${VALIDATION_LOCK_LOG:-\$HOME/validation-lock.log}  now: $lock_log
  Env file  \${VALIDATION_SLOT_ENV:-\$HOME/validation-slot/.env.isolated}  now: $slot_env
  Template  $example_env

Port tool: listeners are found with ss -ltnp on Linux (or lsof one port at a
time if ss is missing) and one lsof call on macOS. Set VALIDATION_PORT_TOOL=ss
or lsof to choose.

owner.md holds one "key: value" line each for id, owner, check, ticket, objective,
started, expected_end (both UTC) and slot_env, then a "repos:" list of
"- name=<name> branch=<branch> sha=<sha> path=<path>" lines.

Exit status: 0 success, 1 refused or failed, 2 usage error.
EOF
}

die() {
	printf 'slot: %s\n' "$*" >&2
	exit 1
}

usage_error() {
	printf 'slot: %s\nRun "slot --help" for usage.\n' "$*" >&2
	exit 2
}

need_value() {
	[ "$#" -ge 2 ] || usage_error "$1 needs a value"
}

reject_newlines() {
	case $2 in
	*"$nl"*) usage_error "$1 must be a single line" ;;
	esac
}

now() {
	date -u +%s
}

# Calendar maths in shell arithmetic (Hinnant's algorithms) because BSD and GNU `date` parse dates differently.
days_from_civil() {
	y=$1
	if [ "$2" -le 2 ]; then
		y=$((y - 1))
		mp=$(($2 + 9))
	else
		mp=$(($2 - 3))
	fi
	era=$((y / 400))
	yoe=$((y - era * 400))
	doy=$(((153 * mp + 2) / 5 + $3 - 1))
	doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
	echo $((era * 146097 + doe - 719468))
}

iso_from_epoch() {
	days=$(($1 / 86400))
	secs=$(($1 % 86400))
	z=$((days + 719468))
	era=$((z / 146097))
	doe=$((z - era * 146097))
	yoe=$(((doe - doe / 1460 + doe / 36524 - doe / 146096) / 365))
	doy=$((doe - (365 * yoe + yoe / 4 - yoe / 100)))
	mp=$(((5 * doy + 2) / 153))
	d=$((doy - (153 * mp + 2) / 5 + 1))
	if [ "$mp" -lt 10 ]; then
		m=$((mp + 3))
	else
		m=$((mp - 9))
	fi
	y=$((yoe + era * 400))
	if [ "$m" -le 2 ]; then
		y=$((y + 1))
	fi
	printf '%04d-%02d-%02dT%02d:%02d:%02dZ\n' "$y" "$m" "$d" $((secs / 3600)) $((secs % 3600 / 60)) $((secs % 60))
}

# Strips leading zeros, which shell arithmetic would read as octal (08 is an error).
dec() {
	digits=$1
	while [ "${#digits}" -gt 1 ] && [ "${digits#0}" != "$digits" ]; do
		digits=${digits#0}
	done
	echo "$digits"
}

epoch_from_iso() {
	case $1 in
	*"$nl"*) return 1 ;;
	esac
	# YYYY-MM-DDTHH:MM[:SS] followed by Z, +HH:MM, -HH:MM, +HHMM or -HHMM
	fields=$(printf '%s\n' "$1" | sed -n -E 's/^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2})(:([0-9]{2}))?(Z|[+-][0-9]{2}:?[0-9]{2})$/\1 \2 \3 \4 \5 \7 \8/p')
	[ -n "$fields" ] || return 1
	# shellcheck disable=SC2086
	set -- $fields
	if [ "$#" -eq 6 ]; then
		year=$(dec "$1") month=$(dec "$2") day=$(dec "$3") hour=$(dec "$4") minute=$(dec "$5") second=0 zone=$6
	else
		year=$(dec "$1") month=$(dec "$2") day=$(dec "$3") hour=$(dec "$4") minute=$(dec "$5") second=$(dec "$6") zone=$7
	fi
	[ "$year" -ge 1970 ] && [ "$month" -ge 1 ] && [ "$month" -le 12 ] && [ "$day" -ge 1 ] && [ "$day" -le 31 ] || return 1
	[ "$hour" -le 23 ] && [ "$minute" -le 59 ] && [ "$second" -le 59 ] || return 1
	offset=0
	if [ "$zone" != Z ]; then
		digits=$(printf '%s' "$zone" | tr -d '+:-')
		zone_hours=$(dec "$(printf '%s' "$digits" | cut -c1-2)")
		zone_minutes=$(dec "$(printf '%s' "$digits" | cut -c3-4)")
		[ "$zone_hours" -le 23 ] && [ "$zone_minutes" -le 59 ] || return 1
		offset=$((zone_hours * 3600 + zone_minutes * 60))
		case $zone in
		-*) offset=$((-offset)) ;;
		esac
	fi
	days=$(days_from_civil "$year" "$month" "$day")
	# Rejects dates like Feb 30 that the arithmetic would silently roll into the next month.
	roundtrip=$(iso_from_epoch $((days * 86400)))
	[ "${roundtrip%%T*}" = "$(printf '%04d-%02d-%02d' "$year" "$month" "$day")" ] || return 1
	echo $((days * 86400 + hour * 3600 + minute * 60 + second - offset))
}

# Prints the epoch for a <time> argument, or fails.
parse_time() {
	case $1 in
	+*m)
		minutes=${1#+}
		minutes=${minutes%m}
		case $minutes in
		'' | *[!0-9]* | ???????*) return 1 ;;
		esac
		minutes=$(dec "$minutes")
		[ "$minutes" -ge 1 ] || return 1
		echo $(($(now) + minutes * 60))
		;;
	*)
		epoch_from_iso "$1"
		;;
	esac
}

future_iso() {
	epoch=$(parse_time "$1") || usage_error "invalid time \"$1\": use +<N>m (up to 6 digits) or ISO-8601 with a zone, e.g. 2026-11-18T15:30:00Z"
	[ "$epoch" -gt "$(now)" ] || usage_error "time \"$1\" is not in the future"
	iso_from_epoch "$epoch"
}

format_duration() {
	minutes=$(($1 / 60))
	if [ "$minutes" -ge 60 ]; then
		printf '%dh%02dm' $((minutes / 60)) $((minutes % 60))
	else
		printf '%dm' "$minutes"
	fi
}

# field <key> [file]: prints the value of "<key>: <value>" from owner.md or the given file.
field() {
	sed -n "s/^$1: //p" "${2:-$owner_file}" 2>/dev/null | head -n 1
}

log_event() {
	line="$(iso_from_epoch "$(now)") $1"
	shift
	while [ "$#" -ge 2 ]; do
		line="$line $1=\"$(printf '%s' "$2" | sed 's/[\\"]/\\&/g')\""
		shift 2
	done
	printf '%s\n' "$line" >>"$lock_log" || printf 'slot: warning: could not write %s\n' "$lock_log" >&2
}

# Prints "overdue", "on-time" or "unknown" for the lock described by the given file.
lock_timing() {
	if ! end_epoch=$(epoch_from_iso "$(field expected_end "$1")"); then
		echo unknown
		return
	fi
	if [ "$(now)" -gt "$end_epoch" ]; then
		echo overdue
	else
		echo on-time
	fi
}

print_holder() {
	echo "locked: $lock_dir"
	if [ -f "$owner_file" ]; then
		echo
		cat "$owner_file"
		echo
		end_epoch=$(epoch_from_iso "$(field expected_end)")
		if [ -z "$end_epoch" ]; then
			echo "state: unknown expiry (expected_end is unreadable; a human must inspect this lock)"
		elif [ "$(now)" -gt "$end_epoch" ]; then
			echo "state: OVERDUE by $(format_duration $(($(now) - end_epoch)))"
		else
			echo "state: $(format_duration $((end_epoch - $(now)))) left"
		fi
		echo "The check: line is not run by slot. Run it yourself to see whether the owner is alive."
		return
	fi
	claimed_by=''
	for claim in "$lock_dir"/owner.md.releasing.* "$lock_dir"/owner.md.breaking.* "$lock_dir"/owner.md.extending.* "$lock_dir"/owner.md.stopping.*; do
		[ -f "$claim" ] || continue
		claimed_by=${claim##*.}
		echo "state: an extend, stop, release or break by PID $claimed_by is in progress."
		echo "If PID $claimed_by is no longer running, it crashed: rename $claim back to $owner_file and rerun."
		echo
		cat "$claim"
	done
	for marker in "$lock_dir"/stopping.*; do
		[ -f "$marker" ] || continue
		claimed_by=${marker##*.}
		echo "state: \"slot stop\" by PID $claimed_by is cleaning up the free slot and holds the lock until it ends."
		echo "If PID $claimed_by is no longer running, it crashed: remove $marker and $lock_dir by hand."
	done
	if [ -z "$claimed_by" ]; then
		echo "state: no owner.md, so an acquire is in progress or one crashed."
		echo "If no acquire is running, a human can inspect and remove $lock_dir by hand."
	fi
}

cmd_acquire() {
	owner='' check='' ticket='' objective='' expected='' repos=''
	while [ "$#" -gt 0 ]; do
		case $1 in
		--owner)
			need_value "$@"
			owner=$2
			;;
		--check)
			need_value "$@"
			check=$2
			;;
		--ticket)
			need_value "$@"
			ticket=$2
			;;
		--objective)
			need_value "$@"
			objective=$2
			;;
		--expected-end)
			need_value "$@"
			expected=$2
			;;
		--repo)
			need_value "$@"
			repos="$repos$(repo_line "$2")$nl" || exit 2
			;;
		*) usage_error "acquire: unknown argument: $1" ;;
		esac
		shift 2
	done
	[ -n "$owner" ] || usage_error "acquire: --owner is required"
	[ -n "$check" ] || usage_error "acquire: --check is required"
	[ -n "$ticket" ] || usage_error "acquire: --ticket is required"
	[ -n "$objective" ] || usage_error "acquire: --objective is required"
	[ -n "$expected" ] || usage_error "acquire: --expected-end is required"
	reject_newlines --owner "$owner"
	reject_newlines --check "$check"
	reject_newlines --ticket "$ticket"
	reject_newlines --objective "$objective"
	expected_end=$(future_iso "$expected") || exit 2
	[ -f "$slot_env" ] || die "no .env.isolated at $slot_env. Copy $example_env there, or set VALIDATION_SLOT_ENV."
	slot_env_path=$(cd "$(dirname "$slot_env")" && pwd)/$(basename "$slot_env")
	reject_newlines VALIDATION_SLOT_ENV "$slot_env_path"
	# Release needs both, so a holder must not find out they're missing only after taking the stack.
	command -v docker >/dev/null 2>&1 || die "docker is not on PATH; the stack runs on it and release needs it. Install it before acquiring."
	pick_port_tool

	mkdir -p "$(dirname "$lock_dir")" || die "cannot create $(dirname "$lock_dir")"
	if ! mkdir "$lock_dir" 2>/dev/null; then
		[ -d "$lock_dir" ] || die "cannot create $lock_dir"
		print_holder
		echo
		printf 'slot: the stack is taken. Follow the stale-lock rule in "slot --help".\n' >&2
		exit 1
	fi

	started_epoch=$(now)
	started=$(iso_from_epoch "$started_epoch")
	lock_id=$started_epoch-$$
	if ! {
		printf '# Isolated stack lock\n\n'
		printf 'id: %s\n' "$lock_id"
		printf 'owner: %s\n' "$owner"
		printf 'check: %s\n' "$check"
		printf 'ticket: %s\n' "$ticket"
		printf 'objective: %s\n' "$objective"
		printf 'started: %s\n' "$started"
		printf 'expected_end: %s\n' "$expected_end"
		printf 'slot_env: %s\n' "$slot_env_path"
		printf 'repos:\n%s' "$repos"
	} >"$owner_file.tmp.$$" || ! mv -f "$owner_file.tmp.$$" "$owner_file"; then
		rm -f "$owner_file.tmp.$$" "$owner_file"
		rmdir "$lock_dir"
		die "could not write $owner_file; lock not taken"
	fi
	log_event acquire owner "$owner" ticket "$ticket" expected_end "$expected_end"
	echo "slot: acquired by $owner until $expected_end"
	echo "slot: lock id $lock_id. Pass --id $lock_id to stop and release, so they only act on this lock."
	token_state=$(slot_env_tokens)
	case $token_state in
	*" ai-set "*) ;;
	*) printf 'slot: warning: ISOLATED_AI_TOKEN is not set in .env.isolated (use the AI_TOKEN from your ai .env). start-isolated refuses to start without it.\n' >&2 ;;
	esac
	case $token_state in
	*" readme-set "*) ;;
	*) printf 'slot: warning: ISOLATED_README_TOKEN is not set in .env.isolated (use SH_MIGRATION_WEBHOOK_AUTH from your readme .env). Without it, gitto'\''s calls to readme return 404.\n' >&2 ;;
	esac
	case $token_state in
	*" readme-list "*) printf 'slot: warning: ISOLATED_README_TOKEN contains a comma; use a single value from SH_MIGRATION_WEBHOOK_AUTH.\n' >&2 ;;
	esac
}

# Run in a subshell. Prints which .env.isolated tokens are set, never their values; bash 3.2 can't parse this case inside $(...).
slot_env_tokens() {
	load_slot_env >/dev/null 2>&1 || return 0
	printf ' %s %s ' "${ISOLATED_AI_TOKEN:+ai-set}" "${ISOLATED_README_TOKEN:+readme-set}"
	case ${ISOLATED_README_TOKEN-} in
	*,*) printf 'readme-list ' ;;
	esac
}

repo_line() {
	case $1 in
	*:*:*:*) ;;
	*) usage_error "--repo \"$1\" must be <name>:<branch>:<sha>:<path>" ;;
	esac
	reject_newlines --repo "$1"
	name=${1%%:*}
	rest=${1#*:}
	branch=${rest%%:*}
	rest=${rest#*:}
	sha=${rest%%:*}
	path=${rest#*:}
	for part in "$name" "$branch" "$sha"; do
		case $part in
		'' | *[[:space:]]*) usage_error "--repo \"$1\": name, branch and sha must be non-empty with no spaces" ;;
		esac
	done
	[ -n "$path" ] || usage_error "--repo \"$1\": path is empty"
	printf -- '- name=%s branch=%s sha=%s path=%s' "$name" "$branch" "$sha" "$path"
}

cmd_status() {
	if [ ! -d "$lock_dir" ]; then
		echo "free: no lock at $lock_dir"
		return
	fi
	print_holder
}

cmd_extend() {
	[ "$#" -eq 1 ] || usage_error "usage: slot extend <+<N>m | ISO-8601>"
	new_end=$(future_iso "$1") || exit 2
	claim_lock extending extend
	old_end=$(field expected_end "$claimed")
	if ! grep -q '^expected_end: ' "$claimed" ||
		! sed "s/^expected_end: .*/expected_end: $new_end/" "$claimed" >"$owner_file.tmp.$$" ||
		! mv -f "$owner_file.tmp.$$" "$claimed"; then
		rm -f "$owner_file.tmp.$$"
		unclaim_lock
		die "could not update expected_end in $owner_file"
	fi
	unclaim_lock
	log_event extend owner "$(field owner)" ticket "$(field ticket)" from "$old_end" to "$new_end"
	echo "slot: expected_end is now $new_end"
}

load_slot_env() {
	[ -f "$slot_env" ] || die "no .env.isolated at $slot_env. Copy $example_env there, or set VALIDATION_SLOT_ENV."
	case $slot_env in
	*/*) env_path=$slot_env ;;
	*) env_path=./$slot_env ;;
	esac
	# Only .env.isolated defines the stack, so ISOLATED_* variables inherited from the caller are dropped first.
	for inherited in $(env | sed -n 's/^\(ISOLATED_[A-Za-z0-9_]*\)=.*/\1/p'); do
		unset "$inherited"
	done
	set -a
	# shellcheck disable=SC1090
	. "$env_path"
	set +a
}

slot_port_vars() {
	{
		for var in $interface_port_vars; do
			echo "$var"
		done
		# load_slot_env exported everything the file set, whatever the assignment form, so env lists exactly what cleanup uses.
		env | sed -n 's/^\(ISOLATED_[A-Za-z0-9_]*_PORT\)=.*/\1/p'
	} | sort -u
}

is_runtime_process() {
	case $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') in
	*docker* | *vpnkit* | *lima* | *orbstack* | *rancher* | *podman* | *gvproxy* | *qemu* | *containerd* | *rootlesskit* | *slirp4netns* | ssh)
		return 0
		;;
	esac
	return 1
}

# Removes the project's containers by label (volumes kept); a compose file would make `down` depend on the caller's cwd.
remove_containers() {
	command -v docker >/dev/null 2>&1 || {
		echo "slot: docker is not on PATH, so the stack's containers can't be stopped" >&2
		return 1
	}
	docker info >/dev/null 2>&1 || {
		echo "slot: the docker daemon is not reachable. Start it, then retry." >&2
		return 1
	}
	containers=$(docker ps -aq --filter "label=com.docker.compose.project=$project") || {
		echo "slot: could not list the containers of compose project $project" >&2
		return 1
	}
	[ -n "$containers" ] || return 0
	# shellcheck disable=SC2086
	host_ports=$(docker inspect --format '{{range $port, $bindings := .HostConfig.PortBindings}}{{range $bindings}}{{.HostPort}} {{end}}{{end}}' $containers) || return 1
	for host_port in $host_ports; do
		case " $ports " in
		*" $host_port "*) ;;
		*)
			echo "slot: compose project $project publishes port $host_port, which isn't a stack port, so it isn't the stack's project. Check ISOLATED_COMPOSE_PROJECT in $slot_env." >&2
			return 1
			;;
		esac
	done
	echo "slot: removing the containers of compose project $project (volumes kept)"
	# shellcheck disable=SC2086
	docker rm -f $containers >/dev/null
}

# Sets $port_tool and $os. lsof 4.99 on Linux aborts on a port list (-iTCP:a,b), so Linux prefers ss.
pick_port_tool() {
	os=$(uname -s)
	port_tool=${VALIDATION_PORT_TOOL-}
	if [ -z "$port_tool" ]; then
		port_tool=lsof
		if [ "$os" != Darwin ] && command -v ss >/dev/null 2>&1; then
			port_tool=ss
		fi
	fi
	case $port_tool in
	ss | lsof) ;;
	*) die "VALIDATION_PORT_TOOL=$port_tool must be ss or lsof" ;;
	esac
	if ! command -v "$port_tool" >/dev/null 2>&1; then
		if [ "$os" = Darwin ]; then
			die "lsof is not on PATH; slot needs it to find listeners on stack ports"
		fi
		die "$port_tool is not on PATH; slot needs ss (from iproute2) or lsof to find listeners on stack ports"
	fi
}

# Prints "<port> <pid>" lines from lsof for the port spec $1 (one port, or a comma list).
lsof_listeners() {
	raw=$(lsof -w -nP -iTCP:"$1" -sTCP:LISTEN -Fpn 2>&1)
	lsof_status=$?
	# lsof exits 1 with no output when nothing listens. -F lines start with p, f or n; anything else is an error message.
	if [ -z "$raw" ] && [ "$lsof_status" -le 1 ]; then
		return 0
	fi
	if [ "$lsof_status" -ne 0 ] || printf '%s\n' "$raw" | grep -q '^[^pfn]'; then
		printf 'slot: lsof failed (exit %s):\n%s\n' "$lsof_status" "$raw" >&2
		return 1
	fi
	printf '%s\n' "$raw" | awk '/^p/ { pid = substr($0, 2) } /^n/ { port = $0; sub(/.*:/, "", port); print port, pid }'
}

# Prints "<port> <pid>" lines from ss for the given ports. ss leaves out the PID of another user's process, so those print "<port>" alone.
ss_listeners() {
	raw=$(ss -ltnpH 2>&1) || {
		printf 'slot: ss failed:\n%s\n' "$raw" >&2
		return 1
	}
	# Fields: state, recv-q, send-q, local address (ends in :<port>), peer, then users:(("<name>",pid=<pid>,fd=<fd>),...).
	printf '%s\n' "$raw" | awk -v ports=" $* " '
		NF == 0 { next }
		$1 != "LISTEN" { bad = 1; exit }
		{
			port = $4
			sub(/.*:/, "", port)
			if (index(ports, " " port " ") == 0) next
			rest = $0
			found = 0
			while (match(rest, /pid=[0-9]+/)) {
				print port, substr(rest, RSTART + 4, RLENGTH - 4)
				found = 1
				rest = substr(rest, RSTART + RLENGTH)
			}
			if (!found) print port
		}
		END { exit bad }' || {
		printf 'slot: unexpected ss output:\n%s\n' "$raw" >&2
		return 1
	}
}

# Prints "<port> <pid>" for each listener on the given ports; needs pick_port_tool first.
port_listeners() {
	if [ "$port_tool" = ss ]; then
		found_all=$(ss_listeners "$@") || return 1
	elif [ "$os" = Darwin ]; then
		# One call for every port, because each takes ~0.6s on macOS.
		found_all=$(lsof_listeners "$(echo "$*" | tr ' ' ',')") || return 1
	else
		found_all=''
		for port in "$@"; do
			found_port=$(lsof_listeners "$port") || return 1
			found_all=$found_all$found_port$nl
		done
	fi
	printf '%s\n' "$found_all" | sed '/^$/d' | sort -u
}

# TERM for 5 rounds, then KILL for 5, one second apart; reports whatever still listens.
free_ports() {
	round=1
	while :; do
		listeners=''
		found=$(port_listeners "$@") || return 1
		while read -r port pid; do
			[ -n "$port" ] || continue
			if [ -z "$pid" ]; then
				listeners="$listeners  port $port: a process you can't see (another user's, such as root's docker-proxy)$nl"
				continue
			fi
			command_name=$(ps -o comm= -p "$pid" 2>/dev/null)
			listeners="$listeners  port $port: PID $pid (${command_name:-unknown})$nl"
			[ "$round" -le 10 ] || continue
			# An unidentified process might be a runtime's port forwarder, so it's reported rather than killed.
			[ -n "$command_name" ] || continue
			# A runtime's port forwarder serves every published container port; killing it would take down the default stack too.
			is_runtime_process "${command_name##*/}" && continue
			if [ "$round" -le 5 ]; then
				signal=TERM
			else
				signal=KILL
			fi
			if [ "$round" -eq 1 ] || [ "$round" -eq 6 ]; then
				echo "slot: sending $signal to PID $pid (${command_name:-unknown}) on port $port"
			fi
			kill -s "$signal" "$pid" 2>/dev/null
		done <<EOF
$found
EOF
		[ -n "$listeners" ] || return 0
		if [ "$round" -gt 10 ]; then
			printf 'slot: these listeners are still running:\n%s' "$listeners" >&2
			return 1
		fi
		round=$((round + 1))
		sleep 1
	done
}

# Loads .env.isolated and sets $ports and $project, refusing default dev ports.
slot_config() {
	load_slot_env

	ports=''
	for var in $(slot_port_vars); do
		eval "port=\${$var-}"
		case $port in
		'') die "$var is not set in $slot_env; see $example_env" ;;
		0* | *[!0-9]*) die "$var=$port in $slot_env is not a port number" ;;
		esac
		[ "$port" -le 65535 ] || die "$var=$port in $slot_env is not a port number"
		for default_port in $default_ports; do
			[ "$port" != "$default_port" ] || die "$var=$port is a default dev port; refusing to touch it. Fix $slot_env."
		done
		ports="$ports $port"
	done
	project=${ISOLATED_COMPOSE_PROJECT-}
	case $project in
	'') die "ISOLATED_COMPOSE_PROJECT is not set in $slot_env; see $example_env" ;;
	*[!a-z0-9_-]* | [!a-z0-9]*) die "ISOLATED_COMPOSE_PROJECT=$project is not a valid compose project name" ;;
	esac
}

stop_slot() {
	pick_port_tool
	slot_config
	remove_containers || die "could not remove the containers of compose project $project"
	# shellcheck disable=SC2086
	free_ports $ports || die "could not free every stack port"
	echo "slot: stopped (ports$ports, compose project $project)"
}

# Renames owner.md so only one extend, stop, release or break acts on this lock at a time; sets $claimed.
claim_lock() {
	[ -d "$lock_dir" ] || die "the stack is not locked"
	claimed=$lock_dir/owner.md.$1.$$
	if ! mv "$owner_file" "$claimed" 2>/dev/null; then
		print_holder
		die "cannot $2: owner.md is missing (see state above)"
	fi
}

unclaim_lock() {
	mv "$claimed" "$owner_file" || die "could not restore $owner_file from $claimed"
}

# Sets $wanted_id from the optional --id of stop and release, and $force_release from release's --force.
parse_id() {
	wanted_id='' force_release=''
	while [ "$#" -gt 0 ]; do
		case $1 in
		--id)
			need_value "$@"
			[ -n "$2" ] || usage_error "--id needs a value"
			wanted_id=$2
			shift 2
			;;
		--force)
			[ "$command" = release ] || usage_error "$command: unknown argument: $1"
			force_release=1
			shift
			;;
		*) usage_error "$command: unknown argument: $1" ;;
		esac
	done
	reject_newlines --id "$wanted_id"
	if [ -n "$force_release" ] && [ -z "$wanted_id" ]; then
		usage_error "release --force needs --id <lock id>: only the holder may force a release"
	fi
}

# A late or repeated stop or release must not act on the next holder's lock.
require_lock_id() {
	[ -n "$wanted_id" ] || return 0
	held_id=$(field id "$claimed")
	[ "$held_id" != "$wanted_id" ] || return 0
	unclaim_lock
	print_holder
	die "this lock's id is \"$held_id\", not \"$wanted_id\", so it isn't yours. Nothing was stopped."
}

# Holds the lock for the whole stop, so the stack can't be released and re-acquired while it is being cleaned up.
cmd_stop() {
	parse_id "$@"
	mkdir -p "$(dirname "$lock_dir")" || die "cannot create $(dirname "$lock_dir")"
	if [ -z "$wanted_id" ] && mkdir "$lock_dir" 2>/dev/null; then
		marker=$lock_dir/stopping.$$
		trap 'rm -f "$marker"; rmdir "$lock_dir"; exit 130' INT TERM HUP
		if ! : >"$marker"; then
			rmdir "$lock_dir"
			die "cannot create $marker"
		fi
		(stop_slot)
		stopped=$?
		rm -f "$marker"
		rmdir "$lock_dir" || printf 'slot: warning: could not remove %s; inspect it by hand\n' "$lock_dir" >&2
	else
		claim_lock stopping stop
		require_lock_id
		trap 'unclaim_lock; exit 130' INT TERM HUP
		(stop_slot)
		stopped=$?
		unclaim_lock
	fi
	trap - INT TERM HUP
	return "$stopped"
}

# Best effort, after a failed stop: lists what still runs in the stack. Errors explain what couldn't be checked.
report_leftovers() {
	slot_config
	(
		command -v docker >/dev/null 2>&1 || die "docker is not on PATH, so the stack's containers are unknown"
		names=$(docker ps -a --filter "label=com.docker.compose.project=$project" --format '{{.Names}} ({{.Status}})') ||
			die "docker ps failed, so the stack's containers are unknown"
		printf '%s\n' "$names" | sed '/^$/d; s/^/container: /'
	)
	(
		pick_port_tool
		# shellcheck disable=SC2086
		found=$(port_listeners $ports) || die "the stack's port listeners are unknown"
		printf '%s\n' "$found" | while read -r port pid; do
			[ -n "$port" ] || continue
			if [ -z "$pid" ]; then
				echo "port $port: a process you can't see"
				continue
			fi
			echo "port $port: PID $pid ($(ps -o comm= -p "$pid" 2>/dev/null))"
		done
	)
}

release_claimed() {
	holder=$(field owner "$claimed")
	ticket=$(field ticket "$claimed")
	recorded_env=$(field slot_env "$claimed")
	if [ -z "$recorded_env" ]; then
		unclaim_lock
		die "owner.md has no slot_env, so slot can't tell which .env.isolated the holder used. Ask a human to inspect the lock."
	fi
	if [ "$recorded_env" != "$slot_env" ]; then
		echo "slot: using the .env.isolated recorded in the lock: $recorded_env"
		slot_env=$recorded_env
	fi
	left=''
	if ! (stop_slot); then
		if [ -z "${force_release-}" ]; then
			unclaim_lock
			if [ "$command" = release ]; then
				die "stop failed, so the lock is kept. Fix the problem above, then run \"slot release\" again. If you hold the lock and can't fix it, \"slot release --id <lock id> --force\" frees it anyway."
			fi
			die "stop failed, so the lock is kept. Fix the problem above, then run \"slot $command\" again."
		fi
		left=$(report_leftovers 2>&1)
		[ -n "$left" ] || left='nothing found'
		printf 'slot: stop failed, but --force frees the lock anyway. Still in the stack:\n%s\n' "$left" >&2
	fi
	rm -f "$owner_file".tmp.*
	# The owner record waits beside the lock dir until rmdir succeeds, so a failure can restore it.
	parked=$lock_dir.released.$$
	mv "$claimed" "$parked" || die "could not move $claimed out of the lock"
	if ! rmdir "$lock_dir" 2>/dev/null; then
		mv "$parked" "$owner_file" || die "could not restore $owner_file from $parked"
		die "the stack is stopped, but $lock_dir holds files other than owner.md (see ls -A $lock_dir). Remove them, then run \"slot release\" again."
	fi
	rm -f "$parked"
	if [ -n "$left" ]; then
		log_event force-release owner "$holder" ticket "$ticket" left "$(printf '%s' "$left" | tr '\n' ';' | sed 's/;/; /g')"
		echo "slot: released with --force. The next holder's \"slot stop\" must clear what's listed above."
		return
	fi
	log_event release owner "$holder" ticket "$ticket"
	echo "slot: released"
}

cmd_release() {
	parse_id "$@"
	[ -d "$lock_dir" ] || die "the stack is not locked; nothing to release. Use \"slot stop\" to clean up without a lock."
	claim_lock releasing release
	require_lock_id
	release_claimed
}

refuse_break() {
	unclaim_lock
	print_holder
	die "$1"
}

cmd_break() {
	reason='' force='' by=''
	while [ "$#" -gt 0 ]; do
		case $1 in
		--reason)
			need_value "$@"
			reason=$2
			shift 2
			;;
		--by)
			need_value "$@"
			by=$2
			shift 2
			;;
		--force)
			force=1
			shift
			;;
		*) usage_error "break: unknown argument: $1" ;;
		esac
	done
	[ -n "$reason" ] || usage_error "break: --reason is required"
	reject_newlines --reason "$reason"
	reject_newlines --by "$by"
	[ -n "$by" ] || by=$(id -un)
	[ -d "$lock_dir" ] || die "the stack is not locked; nothing to break"

	claim_lock breaking break
	case $(lock_timing "$claimed") in
	on-time) refuse_break "the lock is not overdue; refusing to break it. Wait, or ask the owner (see check:)." ;;
	unknown) refuse_break "the lock has no readable expected_end, so it can't be shown to be overdue. Ask a human to inspect it." ;;
	esac
	[ -n "$(field slot_env "$claimed")" ] || refuse_break "owner.md has no slot_env, so slot can't tell which .env.isolated the holder used. Ask a human to inspect the lock."
	holder=$(field owner "$claimed")
	if [ "$holder" = human ] && [ -z "$force" ]; then
		refuse_break "a human holds the lock. Ask them; only rerun with --force if they agree."
	fi
	log_event break by "$by" reason "$reason" owner "$holder" ticket "$(field ticket "$claimed")" expected_end "$(field expected_end "$claimed")"
	release_claimed
}

command=${1-}
[ "$#" -eq 0 ] || shift
for arg in "$@"; do
	case $arg in
	-h | --help)
		usage
		exit 0
		;;
	esac
done
case $command in
acquire | extend | stop | release | break)
	"cmd_$command" "$@"
	;;
status)
	[ "$#" -eq 0 ] || usage_error "$command takes no arguments"
	"cmd_$command"
	;;
-h | --help | help)
	usage
	;;
'')
	usage >&2
	exit 2
	;;
*)
	usage_error "unknown command: $command"
	;;
esac
